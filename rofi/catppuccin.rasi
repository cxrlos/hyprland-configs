/* Catppuccin Mocha theme for rofi */

* {
    base:       #1e1e2ed9;
    mantle:     #181825d9;
    surface0:   #313244ff;
    overlay0:   #6c7086ff;
    subtext0:   #a6adc8ff;
    text:       #cdd6f4ff;
    sky:        #89dcebff;

    background-color:   @base;
    text-color:         @text;
    border-color:       @sky;
    separatorcolor:     @surface0;
}

configuration {
    modi:                "drun,run,window";
    font:                "MonaspiceNe Nerd Font 11";
    show-icons:          true;
    icon-theme:          "Papirus-Dark";
    drun-display-format: "{name}";
    window-format:       "{w}  {c}  {t}";
    display-drun:        "  Apps";
    display-run:         "  Run";
    display-window:      "  Windows";
    kb-cancel:           "Escape,Super+space";
}

window {
    width:            480px;
    border:           1px solid;
    border-color:     @sky;
    border-radius:    12px;
    background-color: @base;
    padding:          0px;
}

mainbox {
    background-color: transparent;
    children:         [inputbar, listview];
    spacing:          0px;
    padding:          0px;
}

inputbar {
    background-color: @mantle;
    border-radius:    12px 12px 0px 0px;
    padding:          10px 12px;
    spacing:          8px;
    children:         [prompt, entry];
}

prompt {
    background-color: transparent;
    text-color:       @sky;
}

entry {
    background-color: transparent;
    text-color:       @text;
    placeholder:      "Search...";
    placeholder-color: @overlay0;
}

listview {
    background-color: @base;
    border-radius:    0px 0px 12px 12px;
    padding:          4px;
    spacing:          0px;
    scrollbar:        false;
    lines:            8;
}

element {
    background-color: transparent;
    text-color:       @text;
    border-radius:    8px;
    padding:          8px 12px;
    spacing:          8px;
    orientation:      horizontal;
}

element selected {
    background-color: @surface0;
    text-color:       @sky;
}

element alternate {
    background-color: transparent;
    text-color:       @subtext0;
}

element-icon {
    background-color: transparent;
    size:             20px;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    vertical-align:   0.5;
}
