/* Neutral chrome for rofi: frosted panel (blur from the Hyprland layer rule), sage selection */

* {
    surface:    #242428b8;
    rim:        #ffffff1f;
    hair:       #ffffff14;
    text:       #ffffffe6;
    text-2:     #ebebf599;
    text-3:     #ebebf552;
    accent:     #83a598ff;
    on-accent:  #1d2021ff;

    background-color: transparent;
    text-color:       @text;
    font:             "Inter 11";
}

configuration {
    modi:                "drun,run,window";
    show-icons:          true;
    icon-theme:          "Papirus-Dark";
    drun-display-format: "{name}";
    window-format:       "{c}  ·  {t}";
    kb-cancel:           "Escape,Super+space";
}

window {
    width:            640px;
    background-color: @surface;
    border:           1px;
    border-color:     @rim;
    border-radius:    14px;
}

mainbox {
    children: [inputbar, message, listview];
    spacing:  0;
}

inputbar {
    children: [textbox-search, entry];
    padding:  16px 18px;
    spacing:  12px;
    border:   0 0 1px 0;
    border-color: @hair;
}

textbox-search {
    expand:         false;
    str:            "";
    font:           "Material Symbols Rounded 16";
    text-color:     @text-2;
    vertical-align: 0.5;
}

entry {
    font:              "Inter 13";
    placeholder:       "Search";
    placeholder-color: @text-3;
    cursor-color:      @accent;
    vertical-align:    0.5;
}

message {
    padding: 10px 18px 0;
}

textbox {
    text-color: @text-2;
}

listview {
    lines:     8;
    padding:   6px;
    spacing:   2px;
    scrollbar: false;
    fixed-height: false;
}

element {
    padding:       8px 12px;
    spacing:       12px;
    border-radius: 8px;
}

element selected {
    background-color: @accent;
    text-color:       @on-accent;
}

element-icon {
    size: 28px;
    text-color: inherit;
}

element-text {
    text-color:     inherit;
    vertical-align: 0.5;
}
