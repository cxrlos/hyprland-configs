{
    "layer": "top",
    "position": "top",
    "height": 30,
    "spacing": 0,
    "exclusive": true,
    "passthrough": false,
    "gtk-layer-shell": true,

    "modules-left": [
        "hyprland/workspaces",
        "hyprland/window"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "group/right"
    ],

    // ── Right cluster — one continuous chip, not a box per module ──────────
    "group/right": {
        "orientation": "horizontal",
        "modules": [
            "cpu",
            "memory",
            "custom/gpu",
            "custom/updates",
            "pulseaudio",
            "custom/mpris",
            "network",
            "custom/caffeine",
            "custom/swaync",
            "tray",
            "custom/power"
        ]
    },

    // ── Workspaces ────────────────────────────────────────────────────────
    "hyprland/workspaces": {
        "format": "{id}",
        "on-click": "activate",
        "sort-by-number": true
    },

    // ── Window title ──────────────────────────────────────────────────────
    "hyprland/window": {
        "format": "{}",
        "rewrite": {
            ".*[Nn]vim.*":           "󰈙 Neovim",
            ".*[Cc]laude.*":         "✻ Claude",
            ".*[Cc]ursor.*":         "✻ Cursor",
            "Alacritty":             "󰆍 Terminal",
            ".*Obsidian.*":          "󰠮 Obsidian",
            ".*File Manager":        "󰉋 Files",
            ".*Spotify.*":           "󰓇 Spotify",
            ".* - Discord":          "󰙯 Discord",
            ".* - Slack":            "󰒱 Slack",
            "Steam":                 "󰓓 Steam",
            ".*Mozilla Firefox":     "󰈹 Firefox",
            ".*Google Chrome":       "󰊯 Chrome",
            ".*Chromium":            "󰊯 Chromium",
            ".*VLC media player":    "󰕼 VLC",
            ".*OBS [0-9].*":         "󰕧 OBS",
            ".*Visual Studio Code":  "󰨞 Code",
            ".*GIMP.*":              "󰋩 GIMP",
            ".*Telegram.*":          "󰖣 Telegram",
            ".*KeePassXC":           "󰌆 KeePassXC",
            ".*Mozilla Thunderbird": "󰇮 Mail"
        },
        "max-length": 50,
        "separate-outputs": true
    },

    // ── Clock ─────────────────────────────────────────────────────────────
    "clock": {
        "format": "{:%A, %B %d    %H:%M}",
        "format-alt": "{:%H:%M}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "on-scroll": 1,
            "format": {
                "today": "<b><u>{}</u></b>"
            }
        }
    },

    // ── CPU ───────────────────────────────────────────────────────────────
    "cpu": {
        "interval": 3,
        "format": " {usage}%",
        "tooltip": true
    },

    // ── Memory ────────────────────────────────────────────────────────────
    "memory": {
        "interval": 3,
        "format": " {used:0.1f}G",
        "tooltip-format": "RAM: {used:0.1f}GiB / {total:0.1f}GiB ({percentage}%)\nSwap: {swapUsed:0.1f}GiB / {swapTotal:0.1f}GiB"
    },

    // ── AMD GPU & VRAM (sysfs) ────────────────────────────────────────────
    "custom/gpu": {
        "format": "{}",
        "return-type": "json",
        "exec": "~/.config/scripts/gpu-metrics.sh",
        "interval": 3,
        "tooltip": true
    },

    // ── Package updates (official repos via checkupdates) ────────────────
    "custom/updates": {
        "format": "{}",
        "return-type": "json",
        "exec": "~/.config/scripts/updates-count.sh",
        "interval": 1800,
        "on-click": "alacritty -e yay",
        "tooltip": true
    },

    // ── Audio ─────────────────────────────────────────────────────────────
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 muted",
        "format-icons": {
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "scroll-step": 5,
        "max-volume": 100,
        "on-click": "~/.config/scripts/scratch.sh wiremix wiremix-scratch wiremix",
        "tooltip-format": "{desc} — {volume}%"
    },

    // ── Now playing (mpris via playerctl) ─────────────────────────────────
    "custom/mpris": {
        "format": "{}",
        "return-type": "json",
        "exec": "~/.config/scripts/mpris-status.sh",
        "interval": 3,
        "on-click": "playerctl play-pause",
        "on-scroll-up": "playerctl next",
        "on-scroll-down": "playerctl previous",
        "tooltip": true
    },

    // ── Network ───────────────────────────────────────────────────────────
    "network": {
        "format-wifi": "{icon} {essid}",
        "format-ethernet": "󰈀 {ipaddr}",
        "format-disconnected": "󰤮 offline",
        "format-icons": ["󰤯", "󰤟", "󰤢", "󰤨"],
        "tooltip-format-wifi": "{ifname}  {ipaddr}\n{signalStrength}% — {bandwidthUpBits}  {bandwidthDownBits}",
        "tooltip-format-ethernet": "{ifname}  {ipaddr}",
        "on-click": "~/.config/scripts/scratch.sh nmtui nmtui-float nmtui",
        "interval": 5
    },

    // ── Caffeine (idle inhibitor) ────────────────────────────────────────
    "custom/caffeine": {
        "format": "{}",
        "return-type": "json",
        "exec": "~/.config/scripts/caffeine.sh status",
        "on-click": "~/.config/scripts/caffeine.sh toggle",
        "signal": 8,
        "tooltip": true
    },

    // ── Power (same as Super+Shift+M) ────────────────────────────────────
    "custom/power": {
        "format": "󰐥",
        "tooltip": false,
        "on-click": "~/.config/scripts/power.sh"
    },

    // ── SwayNC ───────────────────────────────────────────────────────────
    "custom/swaync": {
        "tooltip": false,
        "format": "{icon}",
        "format-icons": {
            "notification": "󰂚",
            "none": "󰂛"
        },
        "return-type": "json",
        "exec-if": "which swaync-client",
        "exec": "swaync-client -swb",
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
        "escape": true
    },

    // ── Tray ──────────────────────────────────────────────────────────────
    "tray": {
        "icon-size": 14,
        "spacing": 8
    }
}
