{
    "layer": "top",
    "position": "top",
    "height": 38,
    "spacing": 4,
    "exclusive": true,
    "passthrough": false,
    "gtk-layer-shell": true,

    "modules-left": [
        "hyprland/workspaces",
        "hyprland/window"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "custom/scores",
        "pulseaudio",
        "network",
        "custom/caffeine",
        "custom/swaync",
        "tray",
        "custom/power"
    ],

    // ── Workspaces ────────────────────────────────────────────────────────
    "hyprland/workspaces": {
        "format": "{id}  {windows}",
        "format-window-separator": " ",
        "window-rewrite-default": "󰖲",
        "window-rewrite": {
            "title<.*[Cc]laude.*>":   "✻",
            "title<.*[Cc]ursor.*>":   "✻",
            "title<.*[Nn]vim.*>":     "󰈙",
            "class<Alacritty>":       "󰆍",
            "class<zen>":             "󰖟",
            "class<zen-browser>":     "󰖟",
            "class<zen-alpha>":       "󰖟",
            "class<Thunar>":          "󰉋",
            "class<thunar>":          "󰉋",
            "class<discord>":         "󰙯",
            "class<Spotify>":         "󰓇",
            "class<Slack>":           "󰒱",
            "class<obsidian>":        "󰠮",
            "class<Obsidian>":        "󰠮",
            "class<steam>":           "󰓓",
            "class<steam_app_.*>":    "󰊴",
            "class<[Ff]irefox>":      "󰈹",
            "class<[Cc]hromium>":     "󰊯",
            "class<[Gg]oogle-chrome>": "󰊯",
            "class<[Vv]lc>":          "󰕼",
            "class<mpv>":             "󰎁",
            "class<com.obsproject.Studio>": "󰕧",
            "class<Code>":            "󰨞",
            "class<[Gg]imp>":         "󰋩",
            "class<org.telegram.desktop>": "",
            "class<org.keepassxc.KeePassXC>": "󰌆",
            "class<[Tt]hunderbird>":  "󰇮"
        },
        "on-click": "activate"
    },

    // ── Window title ──────────────────────────────────────────────────────
    "hyprland/window": {
        "format": "{}",
        "rewrite": {
            ".*Zen Browser":   "󰖟 Zen",
            ".*[Nn]vim.*":     "󰈙 Neovim",
            ".*[Cc]laude.*":   "✻ Claude",
            ".*[Cc]ursor.*":   "✻ Cursor",
            "Alacritty":       "󰆍 Terminal",
            ".*Obsidian.*":    "󰠮 Obsidian",
            ".*File Manager":  "󰉋 Files",
            ".*Spotify.*":     "󰓇 Spotify",
            ".* - Discord":    "󰙯 Discord",
            ".* - Slack":      "󰒱 Slack",
            "Steam":                 "󰓓 Steam",
            ".*Mozilla Firefox":     "󰈹 Firefox",
            ".*Google Chrome":       "󰊯 Chrome",
            ".*Chromium":            "󰊯 Chromium",
            ".*VLC media player":    "󰕼 VLC",
            ".*OBS [0-9].*":         "󰕧 OBS",
            ".*Visual Studio Code":  "󰨞 Code",
            ".*GIMP.*":              "󰋩 GIMP",
            ".*Telegram.*":          " Telegram",
            ".*KeePassXC":           "󰌆 KeePassXC",
            ".*Mozilla Thunderbird": "󰇮 Mail"
        },
        "max-length": 60,
        "separate-outputs": true
    },

    // ── Clock ─────────────────────────────────────────────────────────────
    "clock": {
        "format": "{:%A, %B %d    %H:%M}",
        "format-alt": "{:%H:%M}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "on-scroll": 1,
            "format": {
                "months":   "<span color='#cdd6f4'><b>{}</b></span>",
                "days":     "<span color='#a6adc8'>{}</span>",
                "weeks":    "<span color='#89dceb'><b>W{}</b></span>",
                "weekdays": "<span color='#89dceb'><b>{}</b></span>",
                "today":    "<span color='#f38ba8'><b><u>{}</u></b></span>"
            }
        }
    },

    // ── Sports (live/next matches; hidden when idle) ─────────────────────
    "custom/scores": {
        "format": "{}",
        "return-type": "json",
        "exec": "~/.config/scripts/scores.py",
        "interval": 10,
        "tooltip": false
    },

    // ── Audio ─────────────────────────────────────────────────────────────
    "pulseaudio": {
        "format": "{icon}",
        "format-muted": "󰝟",
        "format-icons": {
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "scroll-step": 5,
        "max-volume": 100,
        "on-click": "~/.config/scripts/scratch.sh wiremix wiremix-scratch wiremix",
        "tooltip-format": "{desc} — {volume}%"
    },

    // ── Network ───────────────────────────────────────────────────────────
    "network": {
        "format-wifi": "{icon} {essid}",
        "format-ethernet": " {ipaddr}",
        "format-disconnected": " disconnected",
        "format-icons": ["󰤯", "󰤟", "󰤢", "󰤨"],
        "tooltip-format-wifi": "{ifname}  {ipaddr}\n{signalStrength}% — {bandwidthUpBits}  {bandwidthDownBits}",
        "tooltip-format-ethernet": "{ifname}  {ipaddr}",
        "on-click": "~/.config/scripts/scratch.sh nmtui nmtui-float nmtui",
        "interval": 5
    },

    // ── Caffeine (idle inhibitor) ────────────────────────────────────────
    "custom/caffeine": {
        "format": "{}",
        "return-type": "json",
        "exec": "~/.config/scripts/caffeine.sh status",
        "on-click": "~/.config/scripts/caffeine.sh toggle",
        "signal": 8,
        "tooltip": true
    },

    // ── Power (same as Super+Shift+M) ────────────────────────────────────
    "custom/power": {
        "format": "󰐥",
        "tooltip": false,
        "on-click": "~/.config/scripts/power.sh"
    },
    "custom/swaync": {
        "tooltip": false,
        "format": "{icon}",
        "format-icons": {
            "notification": "󰂚",
            "none": "󰂛",
            "dnd-notification": "󰂚",
            "dnd-none": "󰂛",
            "inhibited-notification": "󰂚",
            "inhibited-none": "󰂛",
            "dnd-inhibited-notification": "󰂚",
            "dnd-inhibited-none": "󰂛"
        },
        "return-type": "json",
        "exec-if": "which swaync-client",
        "exec": "swaync-client -swb",
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
        "escape": true
    },

    // ── Tray ──────────────────────────────────────────────────────────────
    "tray": {
        "icon-size": 14,
        "spacing": 8
    }
}
